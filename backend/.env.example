# ========================================================
# SAY BACKEND - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ========================================================
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

# --- PostgreSQL Container (Docker Compose) ---
POSTGRES_DB=say_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# --- Spring Boot Backend ---
PORT=8080
SPRING_PROFILES_ACTIVE=local

# YouTube Data API v3 Key (Obtain from Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# PostgreSQL Database Configuration for Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/say_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# Global CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
